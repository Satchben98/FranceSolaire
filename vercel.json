{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/nettoyage-panneaux-solaires/:path*",
      "destination": "/solution-roof-cool/",
      "permanent": true
    },
    {
      "source": "/nettoyage-toitures-industrielles/:path*",
      "destination": "/applications-supports/",
      "permanent": true
    },
    {
      "source": "/zones-intervention/marseille/:path*",
      "destination": "/zones-intervention/",
      "permanent": true
    },
    {
      "source": "/zones-intervention/aix-en-provence/:path*",
      "destination": "/zones-intervention/",
      "permanent": true
    },
    {
      "source": "/zones-intervention/bouches-du-rhone/:path*",
      "destination": "/zones-intervention/",
      "permanent": true
    },
    {
      "source": "/zones-intervention/paca/:path*",
      "destination": "/zones-intervention/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
